APP_NAME="NexaPatch AI"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://nexapatch.example.com

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=nexapatch
DB_USERNAME=nexapatch
DB_PASSWORD=change-this-database-password

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

UPLOAD_MAX_MB=50
UPLOAD_MAX_ENTRIES=2000
UPLOAD_MAX_EXTRACTED_MB=200
UPLOAD_MAX_FILE_MB=10
UPLOAD_MAX_RATIO=100

SECURITY_TOOLS_ENABLED=true
SEMGREP_ENABLED=true
SEMGREP_CONFIG=p/security-audit
GITLEAKS_ENABLED=false
SECURITY_TOOLS_TIMEOUT=450
SCAN_MAX_FINDINGS=3000

OSV_ENABLED=true
SCAN_MODE=queue
SEED_DEMO_USERS=false
FIX_MAX_PATCHES=400

LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_MAX_CALLS=30
LLM_DELAY_MS=500
LLM_TIMEOUT=60
