APP_NAME="NexaPatch AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---- Database (MySQL as per SRS). For a quick start without MySQL see DAY1_SETUP.md (SQLite option).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nexapatch
DB_USERNAME=root
DB_PASSWORD=

# ---- Sessions: expire after 120 minutes of inactivity (FR-002)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true when running behind HTTPS in production
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---- Mail: "log" writes password-reset emails into storage/logs/laravel.log (good for development)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@nexapatch.local"
MAIL_FROM_NAME="${APP_NAME}"

# ---- Login protection
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300

# ---- Seeded demo users (local only). Change or remove before any real deployment.
SEED_DEMO_USERS=true

# ---- Uploads (Day 2). Defaults are used when these lines are absent.
UPLOAD_MAX_MB=50
UPLOAD_MAX_ENTRIES=2000
UPLOAD_MAX_EXTRACTED_MB=200
UPLOAD_MAX_FILE_MB=10
UPLOAD_MAX_RATIO=100

# ---- Local source scanners (no source code is uploaded to a scanner service)
SECURITY_TOOLS_ENABLED=true
SEMGREP_ENABLED=true
SEMGREP_CONFIG=p/security-audit
GITLEAKS_ENABLED=true
SECURITY_TOOLS_TIMEOUT=450

# ---- Optional Gemini AI repair helper
# Get an API key from https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_MAX_CALLS=10
LLM_DELAY_MS=500
LLM_TIMEOUT=45
CA_BUNDLE_PATH=
